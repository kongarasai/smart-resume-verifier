# Database
DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/smart_resume_verifier

# JWT
JWT_SECRET=<your_jwt_secret>
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# GitHub API
GITHUB_TOKEN=<your_github_token>

# OCR Service
OCR_SERVICE_URL=http://localhost:8000

# File Storage (local for dev, S3 for prod)
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# AWS S3 (production)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=smart-resume-verifier
