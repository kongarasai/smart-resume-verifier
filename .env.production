# --- DATABASE CONFIGURATION ---
DB_NAME=smart_resume_verifier
DB_USER=postgres_admin
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE

# --- BACKEND CONFIGURATION ---
# Generate a long random string for JWT_SECRET
JWT_SECRET=YOUR_PRODUCTION_JWT_SECRET_HERE
NODE_ENV=production
PORT=5000

# --- FRONTEND CONFIGURATION ---
# These must match your production domain/IP
# If using Nginx reverse proxy on the same server, '/api' and '/' work.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SOCKET_URL=/

# --- EXTERNAL SERVICES ---
OCR_SERVICE_URL=http://ocr:8000

# --- DOMAIN CONFIGURATION (For SSL) ---
# Uncomment and set these once you have a domain
# DOMAIN_NAME=yourdomain.com
# EMAIL=your@email.com
